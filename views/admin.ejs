<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700;800&family=Figtree:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="shell">
  <aside class="sidebar" aria-label="Admin">
    <div style="display: flex; align-items: center; gap: 12px">
      <div style="width: 42px; height: 42px; border-radius: 13px; background: #F08A24; display: grid; place-items: center; flex: none">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2B1604" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11h16a8 8 0 0 1-16 0z"></path><path d="M9 7c0-1.5 1-1.5 1-3M14 7c0-1.5 1-1.5 1-3"></path></svg>
      </div>
      <div><b class="disp" style="font-size: 18px; display: block; line-height: 1.1">Campus Canteen</b><span style="color: #BFD6C7; font-size: 13px">Admin console</span></div>
    </div>
    <nav class="snav" id="snav" aria-label="Sections"></nav>
    <div style="margin-top: auto; display: flex; flex-direction: column; gap: 10px">
      <p style="color: #BFD6C7; font-size: 13px">Signed in as canteen manager.</p>
      <a class="btn ghost" href="/logout" style="width: 100%">Sign out</a>
    </div>
  </aside>
  <main class="content" id="view"></main>
</div>

<div id="modal"></div>
<div id="toast" aria-live="polite"></div>
<script>window.CANTEEN_ADMIN = <%- json(data) %>;</script>
<script src="/js/admin.js"></script>
</body>
</html>
