<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#14181F">
<meta name="format-detection" content="telephone=no">
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Hanken+Grotesk:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="/css/admin-mobile.css">
</head>
<body>
<div class="shell">
  <aside class="sidebar" aria-label="Admin">
    <div class="sb-brand">
      <div class="sb-logo">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#14181F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11h16a8 8 0 0 1-16 0z"></path><path d="M9 7c0-1.5 1-1.5 1-3M14 7c0-1.5 1-1.5 1-3"></path></svg>
      </div>
      <div class="sb-title"><b class="disp">Campus Canteen</b><span>Admin console</span></div>
    </div>
    <nav class="snav" id="snav" aria-label="Sections"></nav>
    <div class="sb-foot">
      <p>Signed in as canteen manager.</p>
      <a class="btn ghost sb-out" href="/logout">Sign out</a>
    </div>
  </aside>
  <main class="content" id="view"></main>
</div>

<div id="modal"></div>
<div id="toast" aria-live="polite"></div>
<script>window.CANTEEN_ADMIN = <%- json(data) %>;</script>
<script src="/js/admin.js"></script>
</body>
</html>
