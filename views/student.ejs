<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#FFFFFF">
<meta name="format-detection" content="telephone=no">
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Hanken+Grotesk:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="/css/student.css">
</head>
<body>
<header class="top" id="topbar"></header>

<main class="wrap view" id="view"></main>

<footer class="footer-note">
  <div class="wrap footer-inner">Campus Canteen. Pickup only: order here, then show your token at the counter. Payment is collected at the counter or by UPI to the canteen.</div>
</footer>

<div id="toast" aria-live="polite"></div>

<script>
window.CANTEEN_USER = <%- json(user) %>;
window.CANTEEN_MENU = <%- json(menu) %>;
window.CANTEEN_ORDERS = <%- json(orders) %>;
window.CANTEEN_FAVS = <%- json(favourites) %>;
window.CANTEEN_COMBOS = <%- json(combos) %>;
</script>
<script src="/js/student.js"></script>
</body>
</html>
